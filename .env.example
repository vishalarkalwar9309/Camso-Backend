# ============================================================
# CAMSO Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.
# ============================================================

# ── Application ────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Database ───────────────────────────────────────────────
# Neon.tech connection string (per-developer branch recommended)
DATABASE_URL=postgres://user:pass@localhost:5432/camso

# ── JWT ────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Access token lifetime (e.g. 15m, 1h)
JWT_ACCESS_EXPIRES_IN=15m
# Refresh token lifetime in days
JWT_REFRESH_EXPIRES_DAYS=30

# ── Firebase (Admin SDK) ────────────────────────────────────
# IMPORTANT: FIREBASE_PRIVATE_KEY must have literal \n sequences (not real newlines).
# In config/firebase.js, they are unescaped before use.
# See: docs/CAMSO_Backend_Plan.md Section 10
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# ── CORS ───────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# ── Logging ────────────────────────────────────────────────
# One of: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info
