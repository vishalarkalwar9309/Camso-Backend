# =============================================================================
# CAMSO Backend — Environment Variables
# Copy this file to .env and fill in your local values.
# NEVER commit .env to version control.
# =============================================================================

# Application
NODE_ENV=development
PORT=4000

# Database
# Local dev: matches docker-compose.yml defaults
DATABASE_URL=postgresql://camso:camso_dev_password@localhost:5432/camso

# JWT — generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Both secrets are required. Server will not start without them.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Bcrypt rounds (10–12 recommended; higher = slower hash = more CPU cost per login)
BCRYPT_ROUNDS=12

# Rate limiting
# RATE_LIMIT_WINDOW_MS: window in milliseconds (default: 900000 = 15 minutes)
# RATE_LIMIT_MAX: max requests per window per IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# =============================================================================
# PENDING — awaiting credentials from CEAT
# Uncomment and populate when credentials are received.
# =============================================================================

# Firebase (Firebase Storage + FCM)
# Required for: product image uploads, document uploads, push notifications
# Status: PENDING — CEAT has not provided Firebase project credentials
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_STORAGE_BUCKET=

# =============================================================================
# Supabase Integration (PostgreSQL + Storage)
# =============================================================================
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SECRET_KEY=
# SUPABASE_STORAGE_BUCKET="Camso documents"

# =============================================================================
# Demo Account Configuration (Local development & testing only — used by seed:demo)
# Set your desired demo credentials in your local .env file.
# NEVER commit real passwords or .env to version control.
# =============================================================================
# 1. End User Persona (formerly Customer) — Mobile App
DEMO_END_USER_EMAIL=demo.customer@camso.local
DEMO_END_USER_PASSWORD=
# DEMO_CUSTOMER_PASSWORD is also supported as a backward-compatible fallback
DEMO_CUSTOMER_PASSWORD=

# 2. Super Admin Persona — Admin CMS Dashboard
DEMO_ADMIN_EMAIL=demo.admin@camso.local
DEMO_ADMIN_PASSWORD=

# 3. Dealer Persona — Business Portal
DEMO_DEALER_EMAIL=demo.dealer@camso.local
DEMO_DEALER_PASSWORD=

# 4. Distributor Persona — Business Portal
DEMO_DISTRIBUTOR_EMAIL=demo.distributor@camso.local
DEMO_DISTRIBUTOR_PASSWORD=

# 5. OEM Partner Persona — Business Portal
DEMO_OEM_EMAIL=demo.oem@camso.local
DEMO_OEM_PASSWORD=

# 6. Employee Persona — Mobile App Fast Login (Offline client persona; no backend DB role/table)
DEMO_EMPLOYEE_EMAIL=employee@ceat.com
DEMO_EMPLOYEE_PASSWORD=

# 7. Guest Persona — Mobile App (Passwordless; no credentials required)
