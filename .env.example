# =============================================================================
# CAMSO Backend — Environment Variables
# Copy this file to .env and fill in your local values.
# NEVER commit .env to version control.
# =============================================================================

# Application
NODE_ENV=development
PORT=4000

# Database
# Local dev: matches docker-compose.yml defaults
DATABASE_URL=postgresql://camso:camso_dev_password@localhost:5432/camso

# JWT — generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Both secrets are required. Server will not start without them.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Bcrypt rounds (10–12 recommended; higher = slower hash = more CPU cost per login)
BCRYPT_ROUNDS=12

# Rate limiting
# RATE_LIMIT_WINDOW_MS: window in milliseconds (default: 900000 = 15 minutes)
# RATE_LIMIT_MAX: max requests per window per IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# =============================================================================
# PENDING — awaiting credentials from CEAT
# Uncomment and populate when credentials are received.
# =============================================================================

# Firebase (Firebase Storage + FCM)
# Required for: product image uploads, document uploads, push notifications
# Status: PENDING — CEAT has not provided Firebase project credentials
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_STORAGE_BUCKET=

# =============================================================================
# Demo Credentials (Local development & testing only — required by npm run seed:demo)
# Set your desired demo passwords in your local .env file.
# NEVER commit real passwords or .env to version control.
# =============================================================================
DEMO_CUSTOMER_PASSWORD=
DEMO_ADMIN_PASSWORD=
DEMO_DEALER_PASSWORD=
DEMO_DISTRIBUTOR_PASSWORD=
